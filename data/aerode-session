#!/bin/sh
# Aerode X session entry point (selected from your display manager).
export XDG_CURRENT_DESKTOP=Aerode
export XDG_SESSION_DESKTOP=aerode
export DESKTOP_SESSION=aerode
export GTK_THEME=Aerode
export QT_QPA_PLATFORMTHEME=gtk3
# Chromium/Electron (Brave, Discord, Claude...) only use KWallet when the desktop says KDE; otherwise
# they read an empty keyring, can't decrypt cookies and drop every login.
# ponytail: also makes portals/xdg-open treat us as KDE; use per-app --password-store flags if that bites
KWALLET=; [ -f "$HOME/.local/share/kwalletd/kdewallet.kwl" ] && KWALLET=1 && export XDG_CURRENT_DESKTOP=Aerode:KDE KDE_SESSION_VERSION=6
[ -d "$HOME/.local/share/icons/Aerode-cursors" ] && export XCURSOR_THEME=Aerode-cursors
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/aerode"
mkdir -p "$CONF"
SHARE=/usr/share/aerode
# Ease of Access > Make the computer easier to see > High Contrast (GTK's built-in high contrast themes)
[ -s "$CONF/high-contrast" ] && export GTK_THEME="$(cat "$CONF/high-contrast")"
# Region and Language: formats and display language (~/.config/locale.conf), which not every
# display manager reads for X sessions
LOCALECONF="${XDG_CONFIG_HOME:-$HOME/.config}/locale.conf"
[ -r "$LOCALECONF" ] && { set -a; . "$LOCALECONF"; set +a; }
# pointer scheme chosen in Control Panel > Mouse > Pointers
[ -s "$CONF/cursor-theme" ] && export XCURSOR_THEME="$(cat "$CONF/cursor-theme")"
# pointer size chosen in Ease of Access > Make the mouse easier to use (Large / Extra Large)
[ -s "$CONF/cursor-size" ] && export XCURSOR_SIZE="$(cat "$CONF/cursor-size")"
# user variables from System Properties > Environment Variables (~/.config/environment.d), which
# display managers don't read for X sessions
ENVGEN=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator
if [ -x "$ENVGEN" ]; then
  ENVD=$("$ENVGEN" 2>/dev/null)
  # the generator prints KEY=value, quoting values that contain spaces
  while IFS= read -r l; do case "$l" in [A-Za-z_]*=*) k=${l%%=*}; v=${l#*=}
    case "$v" in \"*\") v=${v#\"}; v=${v%\"};; esac; export "$k=$v";; esac; done <<EOT
$ENVD
EOT
fi

# GTK/Xsettings for the session only (icons, cursors, fonts)
ICONS=Papirus; [ -f "$HOME/.local/share/icons/Aerode/index.theme" ] && ICONS=Aerode
# font smoothing / ClearType and recent-files privacy chosen in Control Panel (Fonts, Taskbar and Start Menu)
XFT=$(cat "$CONF/xsettings-cp.conf" 2>/dev/null) || XFT='Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintfull"
Xft/RGBA "rgb"'
cat > "$CONF/xsettingsd.conf" <<EOT
Net/ThemeName "Aerode"
Net/IconThemeName "$ICONS"
Gtk/CursorThemeName "${XCURSOR_THEME:-Adwaita}"
${XCURSOR_SIZE:+Gtk/CursorThemeSize $XCURSOR_SIZE}
Gtk/FontName "Segoe UI 9"
Gtk/MenuImages 1
Gtk/ButtonImages 1
$XFT
EOT
command -v xsettingsd >/dev/null && xsettingsd -c "$CONF/xsettingsd.conf" &
xsetroot -cursor_name left_ptr 2>/dev/null
[ -f "$CONF/Xresources" ] && xrdb -merge "$CONF/Xresources"
# Ease of Access settings that start each time you log on (Sticky/Filter/Mouse Keys, pointer
# size and colour, Magnifier/Narrator/On-Screen Keyboard)
command -v aerode-control >/dev/null && aerode-control --apply-access &

# settings saved by Control Panel (resolution + refresh rate, keyboard layouts, screen timeout)
[ -x "$CONF/displays.sh" ] || [ -f "$CONF/displays.sh" ] && sh "$CONF/displays.sh"
[ -f "$CONF/keyboard.sh" ] && sh "$CONF/keyboard.sh"
# Mouse and Keyboard Properties (xinput pointer speed/buttons, key repeat)
[ -f "$CONF/input.sh" ] && sh "$CONF/input.sh"
# Power Options > Turn off the display (the shell's power watcher keeps it up to date with the plan)
[ -f "$CONF/display-off" ] && { t=$(cat "$CONF/display-off"); [ "$t" = 0 ] && xset -dpms || xset +dpms dpms 0 0 "$t"; }
# Screen Saver Settings > Wait (seconds, 0 = no screen saver and no lock); xss-lock below runs it
[ -f "$CONF/screensaver-wait" ] && { t=$(cat "$CONF/screensaver-wait"); [ "$t" = 0 ] && xset s off || xset s "$t"; }

dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP KDE_SESSION_VERSION 2>/dev/null
# helpers Plasma would provide (all optional)
# UAC-style polkit agent (falls back to other agents if ours is missing)
if command -v aerode-polkit >/dev/null; then aerode-polkit &
else for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/lxqt-policykit-agent; do
  [ -x "$agent" ] && { "$agent" & break; }; done; fi
command -v xss-lock >/dev/null && xss-lock -- aerode screensaver &
# a copy saved by an older Control Panel lacks newer rules: rebuild it from the shipped one (keeping VSync off)
if [ -f "$CONF/picom.conf" ] && ! grep -q "^# aerode-picom 2" "$CONF/picom.conf"; then
  if grep -q "vsync = false" "$CONF/picom.conf"; then sed 's/vsync = true;/vsync = false;/' "$SHARE/picom.conf" > "$CONF/picom.conf"; else rm -f "$CONF/picom.conf"; fi
fi
PICOM_CONF="$SHARE/picom.conf"; [ -f "$CONF/picom.conf" ] && PICOM_CONF="$CONF/picom.conf"
command -v picom >/dev/null && [ ! -f "$CONF/no-compositor" ] && picom --config "$PICOM_CONF" -b
command -v udiskie >/dev/null && udiskie --no-tray &
[ -z "$KWALLET" ] && command -v gnome-keyring-daemon >/dev/null && eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)" && export SSH_AUTH_SOCK

# the shell (desktop, taskbar, Start): started again if it crashes (a panic in a GTK callback
# aborts); 'aerode quit' (0) and 'aerode restart' (SIGTERM) end the loop
(
  crashes=""
  while :; do
    aerode shell; rc=$?
    case $rc in 101|134|139) ;; *) exit 0 ;; esac
    now=$(date +%s); crashes="$(for t in $crashes; do [ $((now - t)) -lt 60 ] && echo "$t"; done) $now"
    [ "$(echo $crashes | wc -w)" -ge 5 ] && exit 0
    echo "aerode-session: aerode shell crashed ($rc), restarting" >&2
    sleep 1
  done
) &
# the window manager is the session leader: logging off ends it (SIGTERM). Should it crash
# (panic 101, abort 134, segfault 139), start it again: the X server hands the windows back and
# the new instance adopts them. Give up after 5 crashes within a minute.
crashes=""
while :; do
  aerode-wm; rc=$?
  case $rc in 101|134|139) ;; *) exit $rc ;; esac
  now=$(date +%s); crashes="$(for t in $crashes; do [ $((now - t)) -lt 60 ] && echo "$t"; done) $now"
  [ "$(echo $crashes | wc -w)" -ge 5 ] && exit $rc
  echo "aerode-session: aerode-wm crashed ($rc), restarting" >&2
  sleep 1
done
