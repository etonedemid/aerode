#!/bin/sh
# Aero7 X session entry point (selected from your display manager).
export XDG_CURRENT_DESKTOP=Aero7
export XDG_SESSION_DESKTOP=aero7
export DESKTOP_SESSION=aero7
export GTK_THEME=Aero7
export QT_QPA_PLATFORMTHEME=gtk3
[ -d "$HOME/.local/share/icons/Aero7-cursors" ] && export XCURSOR_THEME=Aero7-cursors
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/aero7"
mkdir -p "$CONF"
SHARE=/usr/share/aero7

# GTK/Xsettings for the session only (icons, cursors, fonts)
ICONS=Papirus; [ -f "$HOME/.local/share/icons/Aero7/index.theme" ] && ICONS=Aero7
cat > "$CONF/xsettingsd.conf" <<EOT
Net/ThemeName "Aero7"
Net/IconThemeName "$ICONS"
Gtk/CursorThemeName "${XCURSOR_THEME:-Adwaita}"
Gtk/FontName "Segoe UI 9"
Gtk/MenuImages 1
Gtk/ButtonImages 1
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintfull"
Xft/RGBA "rgb"
EOT
command -v xsettingsd >/dev/null && xsettingsd -c "$CONF/xsettingsd.conf" &
xsetroot -cursor_name left_ptr 2>/dev/null

dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP 2>/dev/null
# helpers Plasma would provide (all optional)
# UAC-style polkit agent (falls back to other agents if ours is missing)
if command -v aero7-polkit >/dev/null; then aero7-polkit &
else for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 /usr/lib/lxqt-policykit-agent; do
  [ -x "$agent" ] && { "$agent" & break; }; done; fi
command -v xss-lock >/dev/null && xss-lock -- aero7 lock &
command -v picom >/dev/null && [ ! -f "$CONF/no-compositor" ] && picom --config "$SHARE/picom.conf" -b
command -v udiskie >/dev/null && udiskie --no-tray &
command -v gnome-keyring-daemon >/dev/null && eval "$(gnome-keyring-daemon --start --components=secrets,ssh 2>/dev/null)" && export SSH_AUTH_SOCK

aero7 shell &
# the window manager is the session leader: logging off ends it
exec aero7-wm
